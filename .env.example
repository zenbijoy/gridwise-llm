# LLM Provider Configuration
# Supported providers: gemini | groq | openrouter | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_TIMEOUT_SECONDS=18

# Solver Configuration
SOLVER_TIMEOUT_SECONDS=15

# Provider API Keys (Set only the key for your active provider)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Production Rate Limiting & Safety
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_SIZE_BYTES=1048576

# Testing Flags (0 = mock LLM, 1 = live provider call)
RUN_LIVE_LLM_TESTS=0
