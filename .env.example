# LLM Provider Configuration
# Supported providers: gemini | groq | openrouter | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_TIMEOUT_SECONDS=18

# Solver Configuration
SOLVER_TIMEOUT_SECONDS=15

# Provider API Keys (Set key for active provider; multiple OpenRouter keys rotate automatically)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
ANTHROPIC_API_KEY=

# Production Rate Limiting & Safety
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_REQUEST_BODY_SIZE_BYTES=1048576

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://gridwise.duckdns.org

# Testing Flags (0 = mock LLM, 1 = live provider call)
RUN_LIVE_LLM_TESTS=0

